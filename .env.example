# ------------------------------------------------------------
# BupoHub — variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs.
# Ne JAMAIS committer le fichier `.env`.
# ------------------------------------------------------------

# --- Application ---
APP_NAME=BupoHub
APP_URL=http://localhost:3000

# --- Base de données (MySQL / MariaDB) ---
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://bupohub:bupohub@localhost:3306/bupohub"

# --- Sécurité ---
# Secret utilisé pour dériver les tokens (min. 32 caractères aléatoires)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-please-use-a-long-random-string-of-at-least-32-chars"
# Durée de vie d'une session (jours)
SESSION_TTL_DAYS=30

# --- Compte administrateur initial (utilisé par `prisma db seed`) ---
ADMIN_EMAIL=admin@bupo.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD="ChangeMe123!"

# --- Emails (SMTP via Nodemailer). Si SMTP_HOST est vide, les emails sont loggés en console. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BupoHub <no-reply@bupo.local>"

# --- PayPal (optionnel : abonnements & donations). Vide = désactivé. ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- Discord (optionnel : liaison de compte OAuth2 + bot) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- API ---
# Origines autorisées pour l'API (séparées par des virgules). Vide = même origine uniquement.
CORS_ORIGINS=

# --- Intégration Jellyfin / Bupoflix (optionnel : provisionnement + connexion auto) ---
# URL publique du serveur Jellyfin et clé API admin (Jellyfin → Tableau de bord → Clés API)
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- URLs des services Bupo (utilisées par le seed) ---
SERVICE_URL_BUPOFLIX=https://bupoflix.example.com
SERVICE_URL_BUPO_GAMES=https://games.example.com
SERVICE_URL_BUPO_DISCORD=https://discord.gg/example

# Cookies : true = HTTPS obligatoire (défaut en production). Mettre false pour un accès HTTP par IP (temporaire).
COOKIE_SECURE=
